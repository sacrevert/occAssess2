Package: occAssess
Title: Screen Species Occurrence Data for Biases
Version: 1.4.0
Authors@R: c(
    person(given = "Rob",
           family = "Boyd",
           role = "aut",
           email = "robboy@ceh.ac.uk",
           comment = c(ORCID = "0000-0002-7973-9865")),
    person(given = "Oliver",
           family = "Pescott",
           role = c("aut", "cre"),
