Package: occAssess
Title: Screen Species Occurrence Data for Biases
Version: 1.3.0
Authors@R: c(
    person(given = "Rob",
           family = "Boyd",
           role = c("aut", "cre"),
           email = "robboy@ceh.ac.uk",
